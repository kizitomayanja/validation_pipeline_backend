# Database (Supabase Session Pooler or direct Postgres connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret (minimum 32 characters)
JWT_SECRET=change-this-to-a-very-secure-random-secret-at-least-32-chars-long

# Frontend URL (for generating password reset links)
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://validation-frontend-phi.vercel.app

# ------------------------------------------------------------------------------
# Email Delivery Options (Optional for local testing; required to send real emails)
# If left blank, password reset links are printed directly to the terminal console.
# ------------------------------------------------------------------------------

# Option A: Resend API (Recommended - fast, HTTPS, works everywhere)
# RESEND_API_KEY=re_1234567890abcdef
# RESEND_FROM_EMAIL=Ekyama <onboarding@resend.dev>

# Option B: Gmail SMTP
# (Requires Google 2-Step Verification and a 16-char App Password from myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM_EMAIL=your-account@gmail.com
